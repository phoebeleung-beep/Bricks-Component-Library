{"content":[{"id":"ewvmgf","name":"section","parent":0,"children":["gkuqii"],"settings":{"_cssClasses":"p-acc","_attributes":[{"id":"gtvqcz","name":"data-p-acc-effect","value":"wipe"},{"id":"hwfuyq","name":"data-p-acc-open","value":"1"}],"_padding":{"top":"0","right":"0","bottom":"0","left":"0"},"_background":{"color":{"hex":"#efeee9"}},"_cssCustom":"/* ==========================================================\n   P · Accordion Media  v1.0\n   Tweak timing and colour here.\n   ========================================================== */\n%root% {\n  --p-acc-duration: 900ms;\n  --p-acc-ease: cubic-bezier(0.77, 0, 0.18, 1);\n  --p-acc-accent: #e4532f;\n  --p-acc-icon: #9a988f;\n  --p-acc-icon-active: #1d1d1b;\n}\n\n/* ---------- Image stack ---------- */\n%root% .p-acc__frame { isolation: isolate; }\n\n%root% .p-acc__img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  max-width: none;\n  object-fit: cover;\n  transform-origin: 50% 100%;\n  transition: none;\n}\n\n/* Builder / no-JS: only the first image shows */\n%root%:not(.is-ready) .p-acc__img ~ .p-acc__img { opacity: 0; }\n\n/* Wipe + Curtain: reveal upwards, outgoing image sinks back */\n%root%.p-acc--wipe .p-acc__img,\n%root%.p-acc--curtain .p-acc__img {\n  clip-path: inset(100% 0 0 0);\n  transform: scale(1.14);\n}\n%root%.p-acc--wipe .p-acc__img.is-active,\n%root%.p-acc--curtain .p-acc__img.is-active {\n  clip-path: inset(0 0 0 0);\n  transform: scale(1);\n}\n%root%.p-acc--wipe .p-acc__img.is-shown,\n%root%.p-acc--curtain .p-acc__img.is-shown {\n  clip-path: inset(0 0 0 0);\n  transform: scale(1.08);\n  filter: brightness(0.8);\n}\n\n/* Fade: crossfade with a slow settle */\n%root%.p-acc--fade .p-acc__img {\n  opacity: 0;\n  transform: scale(1.06);\n  transform-origin: 50% 50%;\n}\n%root%.p-acc--fade .p-acc__img.is-active,\n%root%.p-acc--fade .p-acc__img.is-shown {\n  opacity: 1;\n  transform: scale(1);\n}\n\n%root%.is-animated .p-acc__img.is-active,\n%root%.is-animated .p-acc__img.is-shown {\n  transition:\n    clip-path var(--p-acc-duration) var(--p-acc-ease),\n    opacity var(--p-acc-duration) var(--p-acc-ease),\n    transform calc(var(--p-acc-duration) * 1.3) var(--p-acc-ease),\n    filter var(--p-acc-duration) var(--p-acc-ease);\n}\n\n/* Curtain: an accent layer leads, the image follows */\n%root% .p-acc__curtain {\n  position: absolute;\n  inset: 0;\n  background: var(--p-acc-accent);\n  clip-path: inset(100% 0 0 0);\n  pointer-events: none;\n}\n%root% .p-acc__curtain.is-running { clip-path: inset(0 0 0 0); }\n%root%.is-animated .p-acc__curtain.is-running {\n  transition: clip-path calc(var(--p-acc-duration) * 0.6) var(--p-acc-ease);\n}\n%root%.is-animated.p-acc--curtain .p-acc__img.is-active {\n  transition-delay: calc(var(--p-acc-duration) * 0.18);\n}\n\n/* ---------- Accordion ---------- */\n%root% .p-acc__item { position: relative; }\n%root% .p-acc__trigger { cursor: pointer; }\n\n%root% .p-acc__btn {\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: 0;\n  margin: 0;\n  padding: 0;\n  font: inherit;\n  color: inherit;\n  letter-spacing: inherit;\n  text-transform: inherit;\n  text-align: inherit;\n  line-height: inherit;\n  cursor: pointer;\n}\n/* Whole row is clickable */\n%root% .p-acc__btn::after { content: \"\"; position: absolute; inset: 0; }\n%root% .p-acc__btn:focus-visible { outline: 2px solid var(--p-acc-accent); outline-offset: 6px; }\n\n/* Plus → minus */\n%root% .p-acc__icon {\n  position: relative;\n  flex: 0 0 auto;\n  width: 20px;\n  height: 20px;\n  color: var(--p-acc-icon);\n  pointer-events: none;\n  transition: color 0.3s ease;\n}\n%root% .p-acc__icon::before,\n%root% .p-acc__icon::after {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 50%;\n  width: 100%;\n  height: 1.5px;\n  margin-top: -0.75px;\n  background: currentColor;\n}\n%root% .p-acc__icon::after { transform: rotate(90deg); }\n%root%.is-animated .p-acc__icon::after { transition: transform var(--p-acc-duration) var(--p-acc-ease); }\n%root% .p-acc__item:hover .p-acc__icon,\n%root% .p-acc__item.is-open .p-acc__icon { color: var(--p-acc-icon-active); }\n%root% .p-acc__item.is-open .p-acc__icon::after { transform: rotate(0deg); }\n\n/* Height: grid 0fr → 1fr (no JS measuring) */\n%root% .p-acc__panel-inner { min-height: 0; overflow: hidden; }\n%root%.is-ready .p-acc__panel {\n  display: grid;\n  grid-template-rows: 0fr;\n  position: relative;\n  z-index: 1;\n}\n%root%.is-ready .p-acc__item.is-open .p-acc__panel { grid-template-rows: 1fr; }\n%root%.is-ready .p-acc__desc { opacity: 0; transform: translateY(10px); }\n%root%.is-ready .p-acc__item.is-open .p-acc__desc { opacity: 1; transform: none; }\n\n%root%.is-animated .p-acc__panel {\n  transition: grid-template-rows calc(var(--p-acc-duration) * 0.75) var(--p-acc-ease);\n}\n%root%.is-animated .p-acc__desc {\n  transition: opacity 0.35s ease, transform 0.5s var(--p-acc-ease);\n}\n%root%.is-animated .p-acc__item.is-open .p-acc__desc { transition-delay: 0.18s; }\n\n@media (prefers-reduced-motion: reduce) {\n  %root% { --p-acc-duration: 1ms; }\n  %root%.is-animated .p-acc__desc { transition-duration: 1ms; }\n}\n"},"label":"P · Accordion Media"},{"id":"gkuqii","name":"container","parent":"ewvmgf","children":["pdnggd","hhvjzu"],"settings":{"_width":"100%","_widthMax":"100%","_display":"grid","_gridTemplateColumns":"1fr 1fr","_gridTemplateColumns:tablet_portrait":"1fr","_columnGap":"0","_rowGap":"0"},"label":"Grid"},{"id":"pdnggd","name":"block","parent":"gkuqii","children":["nfvokk"],"settings":{"_cssClasses":"p-acc__media","_heightMin":"640px","_heightMin:tablet_portrait":"0","_order:tablet_portrait":"2","_position:tablet_portrait":"sticky","_top:tablet_portrait":"0","_zIndex:tablet_portrait":"2"},"label":"Media"},{"id":"nfvokk","name":"block","parent":"pdnggd","children":["orpdms","lcljef","njdvdk","eauoir","ihzjqe","dauhcj"],"settings":{"_cssClasses":"p-acc__frame","_position":"sticky","_top":"0","_height":"100vh","_heightMax":"100%","_o